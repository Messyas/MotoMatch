# ==============================================================================
# PhoneMatch — Configuração do Ambiente de Desenvolvimento (Docker / Local)
# ==============================================================================
# Copie este arquivo para .env na raiz (ou backend/.env) para configurar suas chaves.

# --- Backend API ---
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Banco de Dados PostgreSQL 16 + pgvector ---
# Dentro do docker-compose: postgresql://phonematch:phonematch@postgres:5432/phonematch?sslmode=disable
# No host: postgresql://phonematch:phonematch@localhost:5432/phonematch?sslmode=disable
DATABASE_URL=postgresql://phonematch:phonematch@postgres:5432/phonematch?sslmode=disable
DATABASE_MAX_CONNECTIONS=5

# --- Segurança e Administração (mínimo 24 caracteres) ---
ADMIN_KEY=your-admin-key-min-24-chars-long
CRON_SECRET=your-cron-secret-min-24-chars-long
CREDENTIALS_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Google Gemini AI (Google AI Studio) ---
# Modelos suportados pela Google GenAI API:
# - gemini-1.5-flash (padrão: rápido, suporte a 1500 req/dia no free tier)
# - gemini-2.0-flash (nova geração do Gemini)
# - gemini-1.5-pro
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
# Modelo oficial para cálculo de embeddings vetoriais (768 dimensões):
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_DAILY_LIMIT=1500

# --- YouTube Data API v3 (Google Cloud Console) ---
# Cota padrão gratuita de 10.000 unidades diárias
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_DAILY_LIMIT=10000

# --- Mercado Livre API (Opcional - DevCenter) ---
ML_CLIENT_ID=your-ml-client-id
ML_CLIENT_SECRET=your-ml-client-secret
ML_BASE_URL=https://api.mercadolibre.com

# --- Agendador (Scheduler) ---
TICK_MAX_SECONDS=60

# --- Frontend Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:3001
