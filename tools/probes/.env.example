# Mercado Livre (DevCenter > your application). Required for probe:ml.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Optional overrides (defaults shown)
# ML_API_BASE_URL=https://api.mercadolibre.com
# ML_SITE_ID=MLB

# YouTube Data API v3 (Google Cloud Console > Credentials > API key). Required for probe:yt.
YOUTUBE_API_KEY=
# Optional overrides (defaults shown)
# YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
# YOUTUBE_REGION_CODE=BR
# YOUTUBE_RELEVANCE_LANGUAGE=pt
