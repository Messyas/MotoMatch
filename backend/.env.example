# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/phonematch?sslmode=require
DATABASE_MAX_CONNECTIONS=5

# Admin & Internal Security (min. 24 characters)
ADMIN_KEY=your-admin-key-min-24-chars-long
CRON_SECRET=your-cron-secret-min-24-chars-long

# LLM: Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=1500

# Reviews: YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_DAILY_LIMIT=10000

# Catalog Mirror: Mercado Livre (optional for manual catalog mode)
ML_CLIENT_ID=your-ml-client-id
ML_CLIENT_SECRET=your-ml-client-secret
ML_BASE_URL=https://api.mercadolibre.com

# Credentials encryption key (64 hex characters / 32 bytes)
CREDENTIALS_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Scheduler
TICK_MAX_SECONDS=60
