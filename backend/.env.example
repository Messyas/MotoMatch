# ==============================================================================
# PhoneMatch Backend — Variáveis de Ambiente
# ==============================================================================

# Servidor HTTP (Hono)
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Banco de Dados (PostgreSQL 16 com extensão pgvector)
# Para Docker local: postgresql://phonematch:phonematch@localhost:5432/phonematch?sslmode=disable
# Para Aiven nuvem: postgresql://avnadmin:senha@host:port/defaultdb?sslmode=require
DATABASE_URL=postgresql://phonematch:phonematch@localhost:5432/phonematch?sslmode=disable
DATABASE_MAX_CONNECTIONS=5

# Autenticação e Segurança Interna (mínimo 24 caracteres)
ADMIN_KEY=your-admin-key-min-24-chars-long
CRON_SECRET=your-cron-secret-min-24-chars-long

# Chave simétrica para encriptação de credenciais (exatamente 64 caracteres hexadecimais / 32 bytes)
CREDENTIALS_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLM: Google Gemini
# Modelos suportados pela Google GenAI API:
# - gemini-1.5-flash (recomendado: rápido, gratuito e estável)
# - gemini-2.0-flash (nova geração)
# - gemini-1.5-pro (maior capacidade)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
# Modelo oficial para embeddings de texto (768 dimensões no pgvector):
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_DAILY_LIMIT=1500

# Coleta de Opiniões: YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_DAILY_LIMIT=10000

# Espelho de Catálogo: Mercado Livre API (opcional se usar apenas cadastro manual)
ML_CLIENT_ID=your-ml-client-id
ML_CLIENT_SECRET=your-ml-client-secret
ML_BASE_URL=https://api.mercadolibre.com

# Agendador (Scheduler)
TICK_MAX_SECONDS=60
